COMMIT;

-- Q15. Demonstrate implicit commit caused by DDL
START TRANSACTION;

UPDATE employees
SET salary = 85000.00
WHERE emp_id = 101;

-- Requires ALTER permission; execute as an authorized admin
ALTER TABLE employees ADD COLUMN demo_col INT;

-- This cannot undo the UPDATE committed by the DDL implicit commit
ROLLBACK;

