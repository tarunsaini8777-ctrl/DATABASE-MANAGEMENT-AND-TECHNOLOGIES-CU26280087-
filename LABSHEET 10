# Q2 and Q3: Medicine entry form with CSS
@app.route("/add", methods=["GET", "POST"])
def add_medicine():
    if request.method == "POST":
        try:
            medicine_id = get_medicine_id(
                request.form["medicine_id"]
            )
            name = request.form["name"].strip()
            category = request.form["category"].strip()
            price = float(request.form["price"])
            stock = int(request.form["stock"])
            manufacturer = request.form["manufacturer"].strip()

            supplier_name = request.form.get("supplier_name", "").strip()
            supplier_phone = request.form.get("supplier_phone", "").strip()
            supplier_city = request.form.get("supplier_city", "").strip()

            if not name or not category or not manufacturer:
                return add_form("Please fill all required fields.", True)

            if price < 0 or stock < 0:
                return add_form("Price and stock cannot be negative.", True)

            if medicines.find_one({"medicine_id": medicine_id}):
                return add_form("Medicine ID already exists.", True)

            medicine = {
                "medicine_id": medicine_id,
                "name": name,
                "category": category,
                "price": price,
                "stock": stock,
                "manufacturer": manufacturer,
                "supplier": {
                    "name": supplier_name,
                    "phone": supplier_phone,
                    "city": supplier_city
                }
            }

            medicines.insert_one(medicine)

            return redirect(
                url_for(
                    "view_medicines",
                    message="Medicine added successfully."
                )
            )

        except (ValueError, KeyError):
            return add_form("Enter valid medicine details.", True)

        except PyMongoError:
            return add_form("Database operation failed.", True)

    return add_form()


