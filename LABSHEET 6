-- =====================================
-- FUNCTIONS: Q11 TO Q20
-- =====================================

DELIMITER $$

-- Q11. Add Two Numbers
CREATE FUNCTION AddTwoNumbers(a INT, b INT)
RETURNS INT
DETERMINISTIC
NO SQL
BEGIN
    RETURN a + b;
END $$

-- Q12. Find Square
CREATE FUNCTION FindSquare(n INT)
RETURNS INT
DETERMINISTIC
NO SQL
BEGIN
    RETURN n * n;
END $$

-- Q13. Check Pass or Fail
CREATE FUNCTION ResultStatus(m DECIMAL(5,2))
RETURNS VARCHAR(10)
DETERMINISTIC
NO SQL
BEGIN
    IF m >= 50 THEN
        RETURN 'Pass';
    ELSE
        RETURN 'Fail';
    END IF;
END $$

-- Q14. Find Student Grade
CREATE FUNCTION StudentGrade(m DECIMAL(5,2))
RETURNS VARCHAR(2)
DETERMINISTIC
NO SQL
BEGIN
    IF m >= 90 THEN
        RETURN 'A';
    ELSEIF m >= 75 THEN
        RETURN 'B';
    ELSEIF m >= 60 THEN
        RETURN 'C';
    ELSE
        RETURN 'D';
    END IF;
END $$

-- Q15. Find Age Category
CREATE FUNCTION AgeCategory(a INT)
RETURNS VARCHAR(10)
DETERMINISTIC
NO SQL
BEGIN
    IF a >= 18 THEN
        RETURN 'Adult';
    ELSE
        RETURN 'Minor';
    END IF;
END $$

-- Q16. Calculate Bonus
CREATE FUNCTION CalculateBonus(m DECIMAL(5,2))
RETURNS INT
DETERMINISTIC
NO SQL
BEGIN
    IF m >= 90 THEN
        RETURN 1000;
    ELSEIF m >= 75 THEN
        RETURN 500;
    ELSE
        RETURN 200;
    END IF;
END $$

-- Q17. Find Higher Number
CREATE FUNCTION HigherNumber(a INT, b INT)
RETURNS INT
DETERMINISTIC
NO SQL
BEGIN
    IF a > b THEN
        RETURN a;
    ELSE
        RETURN b;
    END IF;
END $$

-- Q18. Calculate Double Marks
CREATE FUNCTION DoubleMarks(m DECIMAL(5,2))
RETURNS DECIMAL(7,2)
DETERMINISTIC
NO SQL
BEGIN
    RETURN m * 2;
END $$

-- Q19. Age After Five Years
CREATE FUNCTION AgeAfterFiveYears(a INT)
RETURNS INT
DETERMINISTIC
NO SQL
BEGIN
    RETURN a + 5;
END $$

DELIMITER ;



