-- Q27. Deadlock simulation
-- SESSION 1: Login as dev_user
START TRANSACTION;
UPDATE employees SET salary = salary + 100
WHERE emp_id = 101;

-- SESSION 2: Login as hr_assistant
START TRANSACTION;
UPDATE employees SET salary = salary + 100
WHERE emp_id = 102;

-- SESSION 1: Run next; it waits for Session 2
UPDATE employees SET salary = salary + 100
WHERE emp_id = 102;

-- SESSION 2: Run next; creates a deadlock cycle
UPDATE employees SET salary = salary + 100
WHERE emp_id = 101;

-- InnoDB detects the deadlock and rolls back one transaction.
-- Commit the surviving transaction after checking its result.

