# Q7: Search by Medicine ID or Medicine Name
@app.route("/search", methods=["GET", "POST"])
def search_medicine():
    content = """
    <h2>Search Medicine</h2>

    <form method="POST">
        <label>Medicine ID or Medicine Name</label>
        <input type="text" name="keyword"
               placeholder="Enter ID or name" required>

        <button type="submit">Search</button>
    </form>
    """

    if request.method == "POST":
        keyword = request.form["keyword"].strip()

        if not keyword:
            return render_page(content, "Enter a medicine ID or name.", True)

        try:
            conditions = [
                {"name": {"$regex": keyword, "$options": "i"}}
            ]

            if keyword.isdigit():
                conditions.append(
                    {"medicine_id": int(keyword)}
                )

            data = list(
                medicines.find({"$or": conditions})
                .sort("medicine_id", 1)
            )

            content += medicine_table(data)

            if not data:
                return render_page(
                    content,
                    "No medicine found.",
                    True
                )

            return render_page(content, "Search completed.")

        except PyMongoError:
            return render_page(content, "Search failed.", True)

    return render_page(content)


# Q8: Update medicine stock
@app.route("/update", methods=["GET", "POST"])
def update_stock():
    content = """
    <h2>Update Medicine Stock</h2>

    <form method="POST">
        <label>Medicine ID</label>
        <input type="number" name="medicine_id" required>

        <label>New Stock</label>
        <input type="number" name="stock" min="0" required>

        <button type="submit">Update Stock</button>
    </form>
    """

    if request.method == "POST":
        try:
            medicine_id = int(request.form["medicine_id"])
            stock = int(request.form["stock"])

            if stock < 0:
                return render_page(
                    content,
                    "Stock cannot be negative.",
                    True
                )

            result = medicines.update_one(
                {"medicine_id": medicine_id},
                {"$set": {"stock": stock}}
            )

            if result.matched_count == 0:
                return render_page(
                    content,
                    "Medicine ID not found.",
                    True
                )

            updated = medicines.find_one(
                {"medicine_id": medicine_id}
            )

            content += medicine_table([updated])

            return render_page(
                content,
                "Stock updated successfully."
            )

        except (ValueError, KeyError):
            return render_page(content, "Enter valid details.", True)

        except PyMongoError:
            return render_page(content, "Stock update failed.", True)

    return render_page(content)


