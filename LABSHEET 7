DELIMITER //

-- Trigger Q1: Audit after inserting doctor
CREATE TRIGGER Trigger_Q1
AFTER INSERT ON Doctors
FOR EACH ROW
BEGIN
    INSERT INTO Doctor_Audit
        (DoctorID, ActionType, NewFee)
    VALUES
        (NEW.DoctorID, 'INSERT', NEW.ConsultationFee);
END //

-- Trigger Q2: Audit changed consultation fee
CREATE TRIGGER Trigger_Q2
AFTER UPDATE ON Doctors
FOR EACH ROW
BEGIN
    IF OLD.ConsultationFee <> NEW.ConsultationFee THEN
        INSERT INTO Doctor_Audit
            (DoctorID, ActionType, OldFee, NewFee)
        VALUES
            (NEW.DoctorID, 'UPDATE_FEE',
             OLD.ConsultationFee, NEW.ConsultationFee);
    END IF;
END //

-- Trigger Q3: Convert doctor name to uppercase
CREATE TRIGGER Trigger_Q3
BEFORE INSERT ON Doctors
FOR EACH ROW
BEGIN
    SET NEW.DoctorName = UPPER(NEW.DoctorName);
END //

-- Trigger Q4: Prevent negative fee during insert
CREATE TRIGGER Trigger_Q4
BEFORE INSERT ON Doctors
FOR EACH ROW
BEGIN
    IF NEW.ConsultationFee < 0 THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Consultation fee cannot be negative';
    END IF;
END //

-- Trigger Q5: Audit deleted doctor
CREATE TRIGGER Trigger_Q5
AFTER DELETE ON Doctors
FOR EACH ROW
BEGIN
    INSERT INTO Doctor_Audit
        (DoctorID, ActionType, OldFee)
    VALUES
        (OLD.DoctorID, 'DELETE', OLD.ConsultationFee);
END //

-- Trigger Q6: Log every changed consultation fee
CREATE TRIGGER Trigger_Q6
AFTER UPDATE ON Doctors
FOR EACH ROW
BEGIN
    IF OLD.ConsultationFee <> NEW.ConsultationFee THEN
        INSERT INTO Fee_Log
            (DoctorID, DoctorName, OldFee, NewFee)
        VALUES
            (NEW.DoctorID, NEW.DoctorName,
             OLD.ConsultationFee, NEW.ConsultationFee);
    END IF;
END //

-- Trigger Q7: Prevent negative fee during update
CREATE TRIGGER Trigger_Q7
BEFORE UPDATE ON Doctors
FOR EACH ROW
BEGIN
    IF NEW.ConsultationFee < 0 THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Consultation fee cannot be negative';
    END IF;
END //

-- Trigger Q8: Normalize lowercase active status
CREATE TRIGGER Trigger_Q8
BEFORE UPDATE ON Doctors
FOR EACH ROW
BEGIN
    IF LOWER(NEW.Status) = 'active' THEN
        SET NEW.Status = 'Active';
    END IF;
END //

-- Trigger Q9: Audit department changes
CREATE TRIGGER Trigger_Q9
AFTER UPDATE ON Doctors
FOR EACH ROW
BEGIN
    IF NOT (OLD.Department <=> NEW.Department) THEN
        INSERT INTO Doctor_Audit
            (DoctorID, ActionType, OldFee, NewFee)
        VALUES
            (NEW.DoctorID, 'DEPARTMENT_CHANGE',
             OLD.ConsultationFee, NEW.ConsultationFee);
    END IF;
END //

-- Trigger Q10: Validate doctor name
CREATE TRIGGER Trigger_Q10
BEFORE INSERT ON Doctors
FOR EACH ROW
BEGIN
    IF NEW.DoctorName IS NULL OR TRIM(NEW.DoctorName) = '' THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Doctor name cannot be empty';
    END IF;
END //

DELIMITER ;

