                <h2>{expensive_name}</h2>
                <p>Price: ₹{expensive_price}</p>
            </div>

            <div class="card">
                <h3>Cheapest Medicine</h3>
                <h2>{cheapest_name}</h2>
                <p>Price: ₹{cheapest_price}</p>
            </div>

        </div>
        """

        return render_page(content)

    except PyMongoError:
        return render_page("Report generation failed.", error=True)


