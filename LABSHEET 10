# Q10: MongoDB filtering and sorting queries
@app.route("/queries", methods=["GET", "POST"])
def queries():
    content = """
    <h2>MongoDB Query Practice</h2>

    <form method="POST">
        <label>Select Query</label>

        <select name="query_type">
            <option value="category">Filter by Category</option>
            <option value="gt50">Price Greater Than ₹50</option>
            <option value="lt100">Price Less Than ₹100</option>
            <option value="lowstock">Stock Less Than 30</option>
            <option value="manufacturer">Filter by Manufacturer</option>
            <option value="priceasc">Sort by Price (Ascending)</option>
            <option value="pricedesc">Sort by Price (Descending)</option>
            <option value="stockasc">Sort by Stock (Ascending)</option>
            <option value="stockdesc">Sort by Stock (Descending)</option>
        </select>

        <label>Category / Manufacturer</label>
        <input type="text" name="keyword"
               placeholder="Enter category or manufacturer">

        <button type="submit">Run Query</button>
    </form>
    """

    if request.method == "POST":
        query_type = request.form.get("query_type")
        keyword = request.form.get("keyword", "").strip()

        query = {}
        sort_field = "medicine_id"
        sort_order = 1

        if query_type == "category":
            if not keyword:
                return render_page(
                    content,
                    "Enter a category name.",
                    True
                )
            query = {"category": {"$regex": keyword, "$options": "i"}}

        elif query_type == "gt50":
            query = {"price": {"$gt": 50}}

        elif query_type == "lt100":
            query = {"price": {"$lt": 100}}

        elif query_type == "lowstock":
            query = {"stock": {"$lt": 30}}

        elif query_type == "manufacturer":
            if not keyword:
                return render_page(
                    content,
                    "Enter a manufacturer name.",
                    True
                )
            query = {
                "manufacturer": {
                    "$regex": keyword,
                    "$options": "i"
                }
            }

        elif query_type == "priceasc":
            sort_field, sort_order = "price", 1

        elif query_type == "pricedesc":
            sort_field, sort_order = "price", -1

        elif query_type == "stockasc":
            sort_field, sort_order = "stock", 1

        elif query_type == "stockdesc":
            sort_field, sort_order = "stock", -1

        try:
            data = list(
                medicines.find(query)
                .sort(sort_field, sort_order)
            )

            content += medicine_table(data)

            return render_page(
                content,
                f"Query executed. Records found: {len(data)}"
            )

        except PyMongoError:
            return render_page(content, "Query failed.", True)

    return render_page(content)


# Q12: Inventory Report
@app.route("/report")
def inventory_report():
    try:
        total_medicines = medicines.count_documents({})

        pipeline = [
            {
                "$group": {
                    "_id": None,
                    "total_stock": {"$sum": "$stock"}
                }
            }
        ]

        stock_result = list(medicines.aggregate(pipeline))
        total_stock = (
            stock_result[0]["total_stock"]
            if stock_result else 0
        )

        low_stock_count = medicines.count_documents(
            {"stock": {"$lt": 30}}
        )

        expensive = medicines.find_one(
            {},
            sort=[("price", -1)]
        )

        cheapest = medicines.find_one(
            {},
            sort=[("price", 1)]
        )

        expensive_name = (
            expensive["name"] if expensive else "No medicines"
        )
        expensive_price = (
            expensive["price"] if expensive else 0
        )

        cheapest_name = (
            cheapest["name"] if cheapest else "No medicines"
        )
        cheapest_price = (
            cheapest["price"] if cheapest else 0
        )

        content = f"""
        <h2>Medicine Inventory Report</h2>

        <div class="cards">

            <div class="card">
                <h3>Total Medicines</h3>
                <h2>{total_medicines}</h2>
            </div>

            <div class="card">
                <h3>Total Stock</h3>
                <h2>{total_stock}</h2>
            </div>

            <div class="card">
                <h3>Low Stock Medicines</h3>
                <h2>{low_stock_count}</h2>
                <a class="btn" href="/low-stock">View</a>
