    for m in data:
        supplier = m.get("supplier", {})
        supplier_name = supplier.get("name", "N/A")
        supplier_phone = supplier.get("phone", "N/A")
        supplier_city = supplier.get("city", "N/A")

        rows += f"""
        <tr>
            <td>{m.get('medicine_id', '')}</td>
            <td>{m.get('name', '')}</td>
            <td>{m.get('category', '')}</td>
            <td>₹{m.get('price', 0)}</td>
            <td>{m.get('stock', 0)}</td>
            <td>{m.get('manufacturer', '')}</td>
            <td>{supplier_name}<br>{supplier_phone}<br>{supplier_city}</td>
            <td>
