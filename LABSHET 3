-- Q21. Salary increase with budget limit
START TRANSACTION;

UPDATE employees
SET salary = salary * 1.15
WHERE dept_id = 10;

SAVEPOINT sp_salary_done;

UPDATE departments
SET budget = budget + 50000
WHERE dept_id = 10;

-- Check budget:
SELECT budget FROM departments WHERE dept_id = 10;

-- If budget exceeds 520000, execute:
ROLLBACK TO SAVEPOINT sp_salary_done;

