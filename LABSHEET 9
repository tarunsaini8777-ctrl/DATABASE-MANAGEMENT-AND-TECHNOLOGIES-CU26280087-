def show(page, **kwargs):
    return render_template_string(PAGE, page=page, **kwargs)


@app.route("/")
def home():
    try:
        client.admin.command("ping")
        connected = True
        count = students.count_documents({})
    except PyMongoError:
        connected = False
        count = 0

    return show("home", connected=connected, count=count)


@app.route("/add", methods=["GET", "POST"])
def add():
    if request.method == "POST":
        try:
            sid = request.form["student_id"].strip()

            if students.find_one({"student_id": sid}):
                flash("Student ID already exists!")
                return redirect(url_for("add"))

            student = {
                "student_id": sid,
                "name": request.form["name"].strip(),
                "age": int(request.form["age"]),
                "gender": request.form["gender"],
                "department": request.form["department"].strip(),
                "marks": float(request.form["marks"])
            }

            if student["age"] <= 0 or not 0 <= student["marks"] <= 100:
                flash("Enter valid age and marks between 0 and 100.")
                return redirect(url_for("add"))

            students.insert_one(student)
            flash("Student added successfully!")
            return redirect(url_for("view_students"))

        except ValueError:
            flash("Age and Marks must be numbers.")
        except PyMongoError:
            flash("MongoDB connection error.")

    return show("add")


@app.route("/students")
def view_students():
    try:
        records = list(students.find().sort("student_id", 1))
    except PyMongoError:
        records = []

    return show(
        "students",
        records=records,
        heading="All Student Records"
    )


@app.route("/search", methods=["GET", "POST"])
def search():
    student = None
    searched = False

    if request.method == "POST":
        searched = True
        try:
            student = students.find_one({
                "student_id": request.form["student_id"].strip()
            })
        except PyMongoError:
            flash("MongoDB connection error.")

    return show("search", student=student, searched=searched)


@app.route("/update", methods=["GET", "POST"])
def update():
    student = None

    if request.method == "POST":
        sid = request.form["student_id"].strip()

        try:
            if request.form.get("mode") == "save":
                data = {
                    "name": request.form["name"].strip(),
                    "age": int(request.form["age"]),
                    "department": request.form["department"].strip(),
                    "marks": float(request.form["marks"])
                }

                if data["age"] <= 0 or not 0 <= data["marks"] <= 100:
                    flash("Enter valid age and marks.")
                    student = students.find_one({"student_id": sid})
                else:
                    result = students.update_one(
                        {"student_id": sid},
                        {"$set": data}
                    )

                    flash(
                        "Student updated successfully!"
                        if result.matched_count
                        else "Student not found."
                    )

                    return redirect(url_for("view_students"))

            else:
                student = students.find_one({"student_id": sid})

                if student is None:
                    flash("Student not found!")

        except (ValueError, PyMongoError):
            flash("Invalid data or MongoDB error.")

    return show("update", student=student)


@app.route("/delete", methods=["GET", "POST"])
def delete():
    if request.method == "POST":
        try:
            result = students.delete_one({
                "student_id": request.form["student_id"].strip()
            })

            flash(
                "Student deleted successfully!"
                if result.deleted_count
                else "Student not found!"
            )

        except PyMongoError:
            flash("MongoDB connection error.")

        return redirect(url_for("delete"))

    return show("delete")


@app.route("/filter", methods=["GET", "POST"])
def filter_students():
    records = []
    heading = "Filter Student Records"

    if request.method == "POST":
        kind = request.form["kind"]

        if kind == "department":
            department = request.form.get("department", "").strip()
            query = {
                "department": {
                    "$regex": "^" + department + "$",
                    "$options": "i"
                }
            }
            heading = "Students by Department"

        elif kind == "above75":
            query = {"marks": {"$gt": 75}}
            heading = "Marks Greater Than 75"

        elif kind == "between":
            query = {"marks": {"$gte": 50, "$lte": 80}}
            heading = "Marks Between 50 and 80"

        else:
            query = {"age": {"$gt": 20}}
            heading = "Students Older Than 20"

        try:
            records = list(students.find(query))
        except PyMongoError:
            flash("MongoDB connection error.")

    return show(
        "filter",
        records=records,
        heading=heading
    )


if __name__ == "__main__":
    app.run(debug=True)
