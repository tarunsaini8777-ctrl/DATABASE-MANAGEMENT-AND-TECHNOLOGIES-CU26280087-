-- =====================================
-- STORED PROCEDURES: Q1 TO Q10
-- =====================================

DELIMITER $$

-- Q1. Display All Students
CREATE PROCEDURE ShowStudents()
BEGIN
    SELECT * FROM Student;
END $$

-- Q2. Display All Departments
CREATE PROCEDURE ShowDepartments()
BEGIN
    SELECT * FROM Department;
END $$

-- Q3. Display All Courses
CREATE PROCEDURE ShowCourses()
BEGIN
    SELECT * FROM Course;
END $$

-- Q4. Display Student by ID
CREATE PROCEDURE GetStudent(IN sid INT)
BEGIN
    SELECT * FROM Student
    WHERE StudentID = sid;
END $$

-- Q5. Display Students by Department
CREATE PROCEDURE GetStudentsByDept(IN did INT)
BEGIN
    SELECT * FROM Student
    WHERE DeptID = did;
END $$

-- Q6. Students Above Given Marks
CREATE PROCEDURE StudentsAboveMarks(IN givenMarks DECIMAL(5,2))
BEGIN
    SELECT * FROM Student
    WHERE Marks > givenMarks;
END $$

-- Q7. Total Number of Students
CREATE PROCEDURE TotalStudents()
BEGIN
    SELECT COUNT(*) AS TotalStudents
    FROM Student;
END $$

-- Q8. Check Student Result
CREATE PROCEDURE CheckResult(IN sid INT)
BEGIN
    SELECT StudentName, Marks,
        IF(Marks >= 50, 'Pass', 'Fail') AS Result
    FROM Student
    WHERE StudentID = sid;
END $$

-- Q9. Students by Gender
CREATE PROCEDURE GetStudentsByGender(IN studentGender VARCHAR(10))
BEGIN
    SELECT * FROM Student
    WHERE Gender = studentGender;
END $$

-- Q10. Students Within Marks Range
CREATE PROCEDURE StudentsBetweenMarks(
    IN minMarks DECIMAL(5,2),
    IN maxMarks DECIMAL(5,2)
)
BEGIN
    SELECT * FROM Student
    WHERE Marks BETWEEN minMarks AND maxMarks;
END $$

DELIMITER ;

