-- Q1: Display all doctors
CREATE PROCEDURE Cursor_Q1()
BEGIN
    DECLARE finished INT DEFAULT 0;
    DECLARE v_id INT;
    DECLARE v_name VARCHAR(50);

    DECLARE cur CURSOR FOR
        SELECT DoctorID, DoctorName FROM Doctors;

    DECLARE CONTINUE HANDLER FOR NOT FOUND SET finished = 1;

    OPEN cur;
    read_loop: LOOP
        FETCH cur INTO v_id, v_name;
        IF finished = 1 THEN
            LEAVE read_loop;
        END IF;
        SELECT v_id AS DoctorID, v_name AS DoctorName;
    END LOOP;
    CLOSE cur;
END //

-- Q2: Doctors with fee greater than 1000
CREATE PROCEDURE Cursor_Q2()
BEGIN
    DECLARE finished INT DEFAULT 0;
    DECLARE v_id INT;
    DECLARE v_name VARCHAR(50);
    DECLARE v_fee DECIMAL(10,2);

    DECLARE cur CURSOR FOR
        SELECT DoctorID, DoctorName, ConsultationFee
        FROM Doctors WHERE ConsultationFee > 1000;

    DECLARE CONTINUE HANDLER FOR NOT FOUND SET finished = 1;

    OPEN cur;
    read_loop: LOOP
        FETCH cur INTO v_id, v_name, v_fee;
        IF finished = 1 THEN LEAVE read_loop; END IF;
        SELECT v_id AS DoctorID, v_name AS DoctorName, v_fee AS Fee;
    END LOOP;
    CLOSE cur;
END //

-- Q3: Total consultation fees
CREATE PROCEDURE Cursor_Q3(OUT total_fee DECIMAL(10,2))
BEGIN
    DECLARE finished INT DEFAULT 0;
    DECLARE v_fee DECIMAL(10,2);
    DECLARE cur CURSOR FOR SELECT ConsultationFee FROM Doctors;
    DECLARE CONTINUE HANDLER FOR NOT FOUND SET finished = 1;

    SET total_fee = 0;
    OPEN cur;
    read_loop: LOOP
        FETCH cur INTO v_fee;
        IF finished = 1 THEN LEAVE read_loop; END IF;
        SET total_fee = total_fee + v_fee;
    END LOOP;
    CLOSE cur;
END //

-- Q4: Count Cardiology doctors
CREATE PROCEDURE Cursor_Q4(OUT doctor_count INT)
BEGIN
    DECLARE finished INT DEFAULT 0;
    DECLARE v_dept VARCHAR(40);
    DECLARE cur CURSOR FOR SELECT Department FROM Doctors;
    DECLARE CONTINUE HANDLER FOR NOT FOUND SET finished = 1;

    SET doctor_count = 0;
    OPEN cur;
    read_loop: LOOP
        FETCH cur INTO v_dept;
        IF finished = 1 THEN LEAVE read_loop; END IF;
        IF v_dept = 'Cardiology' THEN
            SET doctor_count = doctor_count + 1;
        END IF;
    END LOOP;
    CLOSE cur;
END //

-- Q5: Average consultation fee
CREATE PROCEDURE Cursor_Q5(OUT average_fee DECIMAL(10,2))
BEGIN
    DECLARE finished INT DEFAULT 0;
    DECLARE v_fee DECIMAL(10,2);
    DECLARE total_fee DECIMAL(12,2) DEFAULT 0;
    DECLARE total_count INT DEFAULT 0;

    DECLARE cur CURSOR FOR SELECT ConsultationFee FROM Doctors;
    DECLARE CONTINUE HANDLER FOR NOT FOUND SET finished = 1;

    OPEN cur;
    read_loop: LOOP
        FETCH cur INTO v_fee;
        IF finished = 1 THEN LEAVE read_loop; END IF;
        SET total_fee = total_fee + v_fee;
        SET total_count = total_count + 1;
    END LOOP;
    CLOSE cur;

    IF total_count = 0 THEN
        SET average_fee = NULL;
    ELSE
        SET average_fee = total_fee / total_count;
    END IF;
END //

-- Q6: Increase Pediatrics fees by 10%
CREATE PROCEDURE Cursor_Q6()
BEGIN
    DECLARE finished INT DEFAULT 0;
    DECLARE v_id INT;
    DECLARE v_fee DECIMAL(10,2);

    DECLARE cur CURSOR FOR
        SELECT DoctorID, ConsultationFee
        FROM Doctors WHERE Department = 'Pediatrics';

    DECLARE CONTINUE HANDLER FOR NOT FOUND SET finished = 1;

    OPEN cur;
    read_loop: LOOP
        FETCH cur INTO v_id, v_fee;
        IF finished = 1 THEN LEAVE read_loop; END IF;
        UPDATE Doctors
        SET ConsultationFee = v_fee * 1.10
        WHERE DoctorID = v_id;
    END LOOP;
    CLOSE cur;
END //

-- Q7: Set Review for fees below 1000
CREATE PROCEDURE Cursor_Q7()
BEGIN
    DECLARE finished INT DEFAULT 0;
    DECLARE v_id INT;
    DECLARE v_fee DECIMAL(10,2);

    DECLARE cur CURSOR FOR
        SELECT DoctorID, ConsultationFee FROM Doctors;

    DECLARE CONTINUE HANDLER FOR NOT FOUND SET finished = 1;

    OPEN cur;
    read_loop: LOOP
        FETCH cur INTO v_id, v_fee;
        IF finished = 1 THEN LEAVE read_loop; END IF;
        IF v_fee < 1000 THEN
            UPDATE Doctors SET Status = 'Review'
            WHERE DoctorID = v_id;
        END IF;
    END LOOP;
    CLOSE cur;
END //

